# versions.env — 모든 버전·경로·기준값을 한 곳에서 고정한다.
# 스크립트는 이 파일을 common/common.sh를 통해 읽는다. 코드에 값을 하드코딩하지 않는다.
# 값을 바꾸면 가이드북과 논문의 버전 표도 함께 갱신한다.
# 환경변수로 같은 이름을 미리 지정하면 그 값이 우선한다(${VAR:=default} 형태).

# ---------------------------------------------------------------- 호스트
: "${UBUNTU_VERSION:=24.04}"

# ---------------------------------------------------------------- OpenStack (Kolla-Ansible)
: "${OPENSTACK_RELEASE:=2026.1}"
: "${KOLLA_ANSIBLE_VERSION:=22.2.0}"          # pip 설치는 브랜치가 아닌 태그로 고정
: "${ANSIBLE_CORE_VERSION:=2.20.11}"          # Kolla-Ansible 22.2.0 요구 범위: >=2.19,<2.20.99
: "${KOLLA_VENV:=$HOME/kolla-venv}"
: "${KOLLA_CONFIG_DIR:=/etc/kolla}"
: "${KOLLA_INVENTORY:=$HOME/all-in-one}"
: "${PASSWORDS_EMPTY_LINE_MAX:=20}"          # passwords.yml 에서 값이 빈 줄 수가 이보다 많으면 kolla-genpwd 전으로 본다(생성 후에는 *_key 묶음 7줄만 남음)

# kolla venv에 함께 설치하는 파이썬 패키지 (수동 구축에서 확인한 값)
: "${DOCKER_PY_VERSION:=7.2.0}"
: "${DBUS_PYTHON_VERSION:=1.5.1}"
: "${OPENSTACKCLIENT_VERSION:=10.5.0}"
: "${OPENSTACKSDK_VERSION:=4.22.0}"           # 4.23.0 wheel에 openstack/config/defaults.json 누락 -> 4.22.0 고정

# ---------------------------------------------------------------- 도구 바이너리 (/usr/local/bin)
: "${BIN_DIR:=/usr/local/bin}"
: "${KUBECTL_VERSION:=1.35.4}"
: "${TERRAFORM_VERSION:=1.15.9}"
: "${KIND_VERSION:=0.33.0}"
: "${CLUSTERCTL_VERSION:=1.14.3}"

# kind, clusterctl의 sha256. 비어 있으면 검증을 건너뛰고 WARN을 출력한다. (linux-amd64 바이너리 기준)
# kind: GitHub 릴리스 v0.33.0 의 kind-linux-amd64.sha256sum 파일과 일치함을 확인(2026-11-20).
# clusterctl: 서버 파일과 별도로 같은 URL에서 내려받은 파일의 해시가 일치함을 확인(2026-11-20). 업스트림 체크섬 파일과의 대조는 하지 않음.
: "${KIND_SHA256:=aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d}"
: "${CLUSTERCTL_SHA256:=e56f397f55c6fdde6ee8c0fead4fb21270a50e05111180bf68c8ae6c82dfd917}"

# ---------------------------------------------------------------- 0단계 점검 기준 (잠정값)
# 첫 구축 후 실측해 갱신한다. 노드 VM 합계는 12 vCPU / 24GiB / 180GB.
: "${MIN_CPU_THREADS:=24}"
: "${MIN_MEM_GIB:=64}"
: "${MIN_DISK_GIB:=200}"                       # $HOME 이 있는 파일시스템과 /var/lib 기준 여유 공간

# ---------------------------------------------------------------- 네트워크 점검 대상
# 형식: "이름|URL". 응답 코드가 000(연결 실패)이 아니면 통과한다. 401/404도 "응답함"이므로 정상.
KIT_NET_TARGETS=(
  "apt|http://archive.ubuntu.com/ubuntu/"
  "PyPI|https://pypi.org/simple/"
  "opendev.org|https://opendev.org/openstack/kolla-ansible"
  "Ansible Galaxy|https://galaxy.ansible.com/"
  "GitHub|https://github.com/"
  "GitHub raw|https://raw.githubusercontent.com/"
  "Terraform releases|https://releases.hashicorp.com/terraform/"
  "Terraform registry|https://registry.terraform.io/.well-known/terraform.json"
  "dl.k8s.io|https://dl.k8s.io/release/stable.txt"
  "pkgs.k8s.io|https://pkgs.k8s.io/"
  "kind|https://kind.sigs.k8s.io/"
  "Ubuntu releases|https://releases.ubuntu.com/"
  "quay.io|https://quay.io/v2/"
  "registry.k8s.io|https://registry.k8s.io/v2/"
  "ghcr.io|https://ghcr.io/v2/"
  "Docker Hub|https://registry-1.docker.io/v2/"
)
: "${NET_TIMEOUT:=10}"

# ---------------------------------------------------------------- 회차 시작 전 초기 상태 점검(check-clean-state.sh)
: "${TF_COMMON_DIR:=$HOME/tf-common}"          # 2단계 Terraform 작업 디렉터리(수동 구축 기준 경로)
: "${PREV_KIT_NET_CIDR:=192.168.100.0/24}"     # 이전 키트(OpenStack on Kubernetes)의 libvirt 네트워크

# ================================================================ 1단계: 호스트 네트워크(단일 NIC)와 OpenStack 배포
: "${KOLLA_HOSTNAME:=kolla-aio}"                # localhost 는 prechecks 가 거부한다. 값 자체는 임의
: "${KOLLA_CLOUD:=kolla-admin-internal}"        # /etc/kolla/clouds.yaml 의 cloud 이름(post-deploy 가 생성)
: "${HOST_NIC:=eth0}"                           # 물리 NIC. 방화벽 규칙과 NAT 에 쓰인다
: "${KOLLA_VIP:=10.10.10.254}"                  # 관리 VIP 겸 호스트 관리 IP
: "${KOLLA_VIP_PREFIX:=24}"
: "${KOLLA_NET_IF:=kolla0}"                     # dummy 인터페이스(network_interface)
: "${EXT_IF:=veth-ext}"                         # neutron_external_interface (IP 없음)
: "${EXT_HOST_IF:=veth-host}"                   # veth 짝. VM 외부망 게이트웨이
: "${EXT_GW_CIDR:=10.20.20.1/24}"
: "${EXT_NET_CIDR:=10.20.20.0/24}"
: "${HOST_NET_SCRIPT:=/usr/local/sbin/kolla-host-net.sh}"
: "${HOST_NET_UNIT:=/etc/systemd/system/kolla-host-net.service}"
: "${HOST_NET_SYSCTL:=/etc/sysctl.d/99-kolla-host.conf}"
: "${KOLLA_MIN_IMAGES:=29}"                     # pull 후 quay.io/openstack.kolla 이미지 수(자동 구축 실측 29종, 2026-11-24 / 수동 구축 때는 31종)
: "${FORCE_REDEPLOY:=0}"                        # 1이면 이미 배포된 서버에서도 prechecks/deploy 를 다시 실행
: "${KOLLA_EXPECTED_SERVICES:=glance heat heat-cfn keystone neutron nova placement}"

# globals.yml 에 맞출 값. 형식 "키|값" (값은 큰따옴표로 감싸 기록). 수동 구축 최종 결과와 같다.
KOLLA_GLOBALS=(
  "kolla_base_distro|ubuntu"
  "openstack_release|${OPENSTACK_RELEASE}"
  "kolla_internal_vip_address|${KOLLA_VIP}"
  "network_interface|${KOLLA_NET_IF}"
  "neutron_external_interface|${EXT_IF}"
  "enable_haproxy|no"
  "enable_proxysql|no"
  "docker_client_timeout|300"   # 기본 120초. 이미지 압축 해제 등으로 바쁠 때 컨테이너 시작 응답을 기다리다 "Container timed out" 으로 실패(2026-11-24, nova_conductor)
)

# 호스트에서 중지해야 하는 libvirt 계열 유닛. libvirtd 뿐 아니라 virtlogd/virtlockd 도 포함(2단계에서 발견한 누락).
KOLLA_HOST_LIBVIRT_UNITS=(
  libvirtd.socket libvirtd-ro.socket libvirtd-admin.socket libvirtd.service libvirt-guests.service
  virtlogd.socket virtlogd-admin.socket virtlockd.socket virtlockd-admin.socket virtlogd.service virtlockd.service
)

# ------------------------------------------------------------------ 2단계: 노드 이미지, Terraform 공용 자원
: "${IB_REPO:=https://github.com/kubernetes-sigs/image-builder.git}"
: "${IB_COMMIT:=704689a7e24c}"                  # 수동 구축 시 기본 브랜치 HEAD 의 12자리 해시(시간이 지나면 달라질 수 있어 고정)
: "${IB_DIR:=$HOME/image-builder}"
: "${IB_VENV:=$HOME/ib-venv}"                   # Kolla 가상환경과 분리(ansible-core 버전 충돌 방지)
: "${IB_VARS_DIR:=$HOME/ib-vars}"
: "${IB_ANSIBLE_CORE:=2.18.18}"                 # deps-qemu 가 ib-venv 에 설치하는 값(관찰값)
: "${IB_PACKER:=1.9.5}"                         # deps-qemu 가 설치하는 Packer(관찰값)
: "${IB_CPUS:=4}"                               # 빌드 VM 자원(속도용, 필수 아님)
: "${IB_MEMORY:=4096}"
: "${K8S_SERIES:=v1.36}"
: "${K8S_SEMVER:=v1.36.6}"
: "${K8S_DEB_VERSION:=1.36.6-1.1}"
: "${NODE_IMAGE_NAME:=ubuntu-2404-kube-v1.36.6}"
: "${NODE_IMAGE_FILE:=$IB_DIR/images/capi/output/$NODE_IMAGE_NAME/$NODE_IMAGE_NAME}"
: "${NODE_KEY:=$HOME/.ssh/k8s-node-key}"        # 개인 키는 비밀. 저장소와 로그에 넣지 않는다
: "${NODE_FLAVOR:=k8s-node}"
: "${NODE_KEYPAIR:=k8s-key}"
: "${EXT_NET_NAME:=ext-net}"
: "${K8S_NET_NAME:=k8s-net}"
: "${TF_RESOURCE_COUNT:=9}"
: "${TEST_VM_PREFIX:=kit-test}"                 # 검증 a 의 임시 VM 이름 접두사(끝나면 항상 삭제)
: "${FORCE_OVERWRITE_TF:=0}"                    # 1이면 다른 내용의 main.tf 를 백업 후 덮어씀

# ------------------------------------------------------------------ 3단계: kind 관리 클러스터, Cluster API / CAPO
: "${KIND_CLUSTER:=mgmt}"
: "${KUBE_CONTEXT:=kind-${KIND_CLUSTER}}"       # 모든 kubectl/clusterctl 호출에 명시한다(~/.kube/config 에 다른 컨텍스트가 있을 수 있음)
: "${KIND_NODE_IMAGE:=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed}"   # digest 까지 고정(kind 기본 1.37 은 CAPI v1.14 지원 범위 밖)
: "${MGMT_NODE_VERSION:=v1.36.4}"
: "${KIND_NET_CIDR:=172.17.0.0/16}"             # Docker 가 정하는 kind 네트워크 대역(수동 구축 관찰값). 생성 후 실제 값과 대조한다
: "${CAPO_VERSION:=v0.15.1}"
: "${CERT_MANAGER_OBSERVED:=v1.21.2}"           # clusterctl 이 선택한 값(고정하지 않음). 다르면 WARN
: "${KIND_REGISTRIES:=https://quay.io/v2/ https://registry.k8s.io/v2/ https://ghcr.io/v2/ https://registry-1.docker.io/v2/}"
: "${CAPI_NAMESPACES:=capi-system capi-kubeadm-bootstrap-system capi-kubeadm-control-plane-system capo-system cert-manager}"
: "${WAIT_PODS_SECS:=300}"

# ------------------------------------------------------------------ 4단계: CAPO 로 워크로드 클러스터 생성
: "${CLUSTER_NAME:=k8s-lab}"
: "${CAPI_DIR:=$HOME/capi}"                     # 렌더한 주문서, kubeconfig 를 두는 폴더
: "${CLUSTER_MANIFEST:=$CAPI_DIR/${CLUSTER_NAME}.yaml}"
: "${CLUSTER_KUBECONFIG:=$CAPI_DIR/${CLUSTER_NAME}.kubeconfig}"   # 관리자 인증 정보. 권한 600, 공유 금지
: "${CLOUD_SECRET_NAME:=${CLUSTER_NAME}-cloud-config}"
: "${CP_REPLICAS:=1}"
: "${WORKER_REPLICAS:=2}"
: "${POD_CIDR:=192.168.0.0/16}"
: "${NODE_AZ:=nova}"
: "${ORC_VERSION:=v2.0.3}"                      # CAPO v0.15.1 이 요구하는 ORC. 호환은 공식 근거 없이 동작으로만 확인
: "${ORC_URL:=https://github.com/k-orc/openstack-resource-controller/releases/download/${ORC_VERSION}/install.yaml}"
: "${CLUSTER_WAIT_SECS:=1500}"                  # 수동 구축 관찰: VM ACTIVE 약 1분, API 200 약 2분 30초(방화벽 문제 구간 포함)
: "${MIN_NODE_DISK_KI:=57671680}"               # 노드 ephemeral-storage 하한(55GiB). 수동 관찰 61742108Ki
: "${FORCE_OVERWRITE_MANIFEST:=0}"              # 1이면 다른 내용의 주문서를 백업 후 덮어씀

# ------------------------------------------------------------------ 5단계: Calico, OCCM, 검증 b~e
: "${CALICO_VERSION:=v3.33.0}"
: "${CALICO_BASE_URL:=https://raw.githubusercontent.com/projectcalico/calico/${CALICO_VERSION}/manifests}"
: "${CALICO_DIR:=$CAPI_DIR/calico}"
: "${CALICO_ENCAP:=IPIP}"                       # 기본값 VXLANCrossSubnet 에서 이 한 줄만 바꾼다(노드 포트 보안 때문에 IPIP. 근거는 가설)
: "${CALICO_EXPECTED_STATUS:=apiserver calico goldmane ippools tiers whisker}"
: "${TYPHA_PORT:=5473}"                         # CAPO 기본 SG 규칙에 없는 Calico Typha 포트
: "${OCCM_VERSION:=v1.36.0}"                    # CAPO 문서는 master 를 쓰지만 태그로 고정한다
: "${OCCM_BASE_URL:=https://raw.githubusercontent.com/kubernetes/cloud-provider-openstack/${OCCM_VERSION}/manifests/controller-manager}"
: "${OCCM_DIR:=$CAPI_DIR/occm}"
: "${WAIT_CALICO_SECS:=900}"
# 내려받은 매니페스트의 sha256(비어 있으면 검증하지 않고 로그에 해시만 남긴다). 서버에서 sha256sum 으로 확인한 값을 넣어 고정한다.
: "${CALICO_CRD_SHA256:=5306c2c6d9fd6762d804f9da51c049b8269c33498a364c5df0eed555aba026bd}"
: "${CALICO_OPERATOR_SHA256:=aef423b36aef8cf86567f92bbe5eea4b4ca105a6fc7dbf43de599c6fa70388ba}"
: "${CALICO_CR_SHA256:=4fb598a7fce1ad1f8bbfb9004f5efcdb835082e92e06323cb7b8ce60260ed891}"
# 검증 d 시험 자원(끝나면 항상 삭제)
: "${TEST_NS:=kit-test-d}"
: "${TEST_NGINX_IMAGE:=nginx:1.27-alpine}"
: "${TEST_BUSYBOX_IMAGE:=busybox:1.37}"

# ------------------------------------------------------------------ 6단계: 삭제와 검증 f
: "${STAGE6_DIR:=$CAPI_DIR/stage6}"             # 삭제 전후 OpenStack 상태 기록(리소스 ID, IP 포함. 비밀번호는 없음. 공개 저장소에 올리지 않는다)
: "${DELETE_TIMEOUT:=20m}"                      # kubectl delete cluster --timeout (수동: 36초)
: "${CLEANUP_WAIT_SECS:=900}"                   # 삭제 명령 종료 뒤 OpenStack 정리가 끝나기를 기다리는 최대 시간(수동에서는 측정하지 않음)
