# OpenInfra Lab Kit - OpenStack-Helm pinned versions
# 이 파일은 bash가 그대로 읽어 들입니다(source). 형식은 이름="값" 이고 = 양옆에 공백이 없어야 합니다.
# stage4(prepare.sh, postcheck.sh)와 stage5(deploy.sh)가 이 파일의 값을 사용합니다.

# OSH_TAG : OpenStack-Helm 소스의 Git 태그(버전 이름). OpenStack 2026.1 용입니다.
OSH_TAG="2026.1.0"
# OSH_COMMIT : 위 태그가 가리키는 커밋 번호. 태그와 함께 고정해서 "정확히 같은 코드"를 쓰게 합니다.
OSH_COMMIT="c665eedfa3ae1b76a7e8438fffcb62aefaa30a46"
# OSH_CHART_SUFFIX : Helm 차트 버전 뒤에 붙는 꼬리표입니다. 5단계에서 --version "<차트 버전>+c665eedfa" 로 사용됩니다.
OSH_CHART_SUFFIX="+c665eedfa"
# OSH_PLUGIN_VERSION : osh 플러그인 버전 기록용. 현재 스크립트가 이 값을 읽지는 않습니다.
OSH_PLUGIN_VERSION="0.1.0"

# CHART_* : 5단계에서 설치하는 Helm 차트별 버전입니다. (차트 자체의 버전 번호로, OpenStack 릴리스 2026.1 과 다른 숫자일 수 있습니다)
#   RABBITMQ 메시지 큐 / MARIADB 데이터베이스 / MEMCACHED 캐시 / KEYSTONE 인증 / GLANCE 이미지 /
#   OPENVSWITCH 가상 스위치 / LIBVIRT VM 엔진 / PLACEMENT 자원 추적 / NOVA 컴퓨트 / NEUTRON 네트워크
CHART_RABBITMQ="2025.2.11"
CHART_MARIADB="2025.2.9"
CHART_MEMCACHED="2025.2.6"
CHART_KEYSTONE="2025.2.18"
CHART_GLANCE="2025.2.19"
CHART_OPENVSWITCH="2025.2.11"
CHART_LIBVIRT="2025.2.13"
CHART_PLACEMENT="2025.2.16"
CHART_NOVA="2025.2.34"
CHART_NEUTRON="2025.2.30"
